# ─── Application ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/digital_bank

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── NIBSS by Phoenix ─────────────────────────────────────────
# Obtain these by calling POST /api/fintech/onboard with your bank name & email
NIBSS_BASE_URL=https://nibss_by_phoenix_endpoint.com
NIBSS_API_KEY=your_nibss_api_key_here
NIBSS_API_SECRET=your_nibss_api_secret_here

# ─── Bank Info (assigned by NIBSS after onboarding) ───────────
BANK_CODE=
BANK_NAME=
